# Settings > Account > Webhook signing secret, in Manifestly.
# Account-level and shown once. Rotating it invalidates every other webhook
# consumer in the account at the same time.
MANIFESTLY_WEBHOOK_SIGNING_SECRET=

# Which provider this deployment runs: anthropic or openai. A deployment is
# coupled to one. Defaults to anthropic when unset; an unrecognised value
# throws rather than falling back, because the alternative to throwing is
# running the other provider against credentials meant for this one.
AGENT_PROVIDER=anthropic

# --- AGENT_PROVIDER=anthropic ---

# Anthropic API key with access to Managed Agents.
ANTHROPIC_API_KEY=

# The agent, environment and vault that each session is started from.
# The vault holds the Manifestly agent's own API key; the relay never sees it.
CMA_AGENT_ID=
CMA_ENVIRONMENT_ID=
CMA_VAULT_ID=

# --- AGENT_PROVIDER=openai ---

# OpenAI API key. It needs three scopes, not one: Agents write, Vaults write,
# and Responses write. With Agents alone the session is created and the first
# turn returns 401, which reads as a code problem rather than a scope one.
OPENAI_API_KEY=

# The vault holding a static_bearer credential that carries the Manifestly
# agent's API key, keyed to the MCP server URL in agent.yaml. There is no agent
# id here: the Agents API takes the whole definition on every session, so the
# relay sends agent.yaml's system prompt inline.
OPENAI_VAULT_ID=

# Optional. The Agents API is the Codex harness and refuses general models.
OPENAI_MODEL=gpt-6-astra

# --- both ---

# Single-flight claim store (Upstash Redis via the Vercel marketplace
# integration, which sets these for you). Without them the relay still runs and
# starts one session per delivery, which is the duplicate behaviour the claim
# exists to stop. Per deployment, so two providers cannot share pointers.
KV_REST_API_URL=
KV_REST_API_TOKEN=
