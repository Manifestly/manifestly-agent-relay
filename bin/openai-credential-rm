#!/usr/bin/env node
// Removes a credential from a vault, after showing what it is and asking.
// Hard delete, no undo.
//
// Usage: bin/openai-credential-rm <vault_id> <credential_id>
//
// Retire a credential BEFORE revoking the secret at the far end rather than
// after, so the vault stops offering a value that no longer works.
import OpenAI from "openai";
import readline from "node:readline/promises";
import { apiKey } from "./_prompt.mjs";

const [vaultId, credentialId] = process.argv.slice(2);
if (!vaultId || !credentialId) {
  console.error("usage: bin/openai-credential-rm <vault_id> <credential_id>   (both from bin/openai-inspect)");
  process.exit(1);
}

const client = new OpenAI({ apiKey: await apiKey() });

const credential = await client.beta.agents.vaults.credentials.retrieve(credentialId, { vault_id: vaultId });
console.log(`\n${credential.id}`);
console.log(`  name: ${credential.name ?? "(unnamed)"}`);
console.log(`  auth: ${JSON.stringify(credential.auth)}`);

const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
const answer = await rl.question("\nDelete this credential? Type the credential id to confirm: ");
rl.close();

if (answer.trim() !== credentialId) {
  console.log("not confirmed, nothing deleted");
  process.exit(1);
}

await client.beta.agents.vaults.credentials.delete(credentialId, { vault_id: vaultId });
console.log("deleted");
