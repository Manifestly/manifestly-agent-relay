#!/usr/bin/env node
// Print agent.yaml as the JSON body POST /v1/agents expects.
//
// Was Python, and hardcoded name, description, model, mcp_servers and tools as
// literals while reading only the system block from agent.yaml. So the file
// this repo calls its source of truth held a second copy of every value except
// the prompt, and nothing made the two agree. This renders what the relay
// itself parses, which is the only way the two cannot drift.
import { agentDefinition } from "../api/providers/anthropic.js";

process.stdout.write(JSON.stringify(agentDefinition(), null, 2) + "\n");
