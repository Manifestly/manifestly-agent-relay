#!/usr/bin/env node
// Adds the static_bearer credential an OpenAI deployment needs: the Manifestly
// agent's own API key, keyed to the MCP server URL. The value is read from a
// hidden prompt, so it never reaches shell history or the process table.
//
// Usage: bin/openai-credential [vault_id]
//   With no vault id, creates a vault first and prints it for OPENAI_VAULT_ID.
//
// The MCP server URL is read from agent.yaml rather than taken as an argument,
// because that file is the one source of it and a second copy here could point
// a credential at a server the agent never calls.
import OpenAI from "openai";
import { apiKey, hidden } from "./_prompt.mjs";
import { mcpServers } from "../api/_agent_definition.js";

const client = new OpenAI({ apiKey: await apiKey() });

let vaultId = process.argv[2];
if (!vaultId) {
  const vault = await client.beta.agents.vaults.create({ name: "manifestly-agent-relay" });
  vaultId = vault.id;
  console.log(`\nCreated vault ${vaultId}`);
}

// One credential per declared server, rather than one for "the" server.
// agent.yaml holds a list, and the last thing that assumed it held exactly one
// was a regex that silently dropped every entry after the first.
for (const server of mcpServers) {
  console.log(`\nMCP server, from agent.yaml: ${server.name} -> ${server.url}`);

  const token = await hidden(`Manifestly agent API key for ${server.name} (hidden)`);
  if (!token) {
    console.error("no value given, nothing written for this server");
    continue;
  }

  // Both secrets we once pasted into a web form arrived truncated and failed
  // much later as unexplained 401s. Count it going in and compare at the far end.
  console.log(`value length going in: ${token.length}`);

  const credential = await client.beta.agents.vaults.credentials.create(vaultId, {
    name: `${server.name}-mcp`,
    auth: { type: "static_bearer", mcp_server_url: server.url, token },
  });

  console.log(`created ${credential.id}`);
}
console.log(`\nSet OPENAI_VAULT_ID=${vaultId}`);
console.log("The relay matches the credential by server URL, so nothing references the credential id.");
